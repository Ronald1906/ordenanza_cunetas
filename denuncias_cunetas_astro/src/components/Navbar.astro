---
const assetsUrl = import.meta.env.PUBLIC_ASSETS_URL ?? "";
const logoUrl = `${assetsUrl}/logos/logo_gad_blanco.png`;

const currentPath = Astro.url.pathname;

const navItems = [
	{
		label: "Inicio",
		href: "/",
	},
	{
		label: "Formulario",
		href: "/formulario",
	},
	{
		label: "Seguimiento",
		href: "/seguimiento",
	},
];

const isActive = (href: string) => {
	if (href === "/") {
		return currentPath === "/";
	}

	return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-50 bg-[#061B4E] shadow-lg">
	<div
		class="mx-auto flex min-h-20 w-full max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8"
	>
		<!-- Identidad institucional -->
		<a
			href="/"
			class="flex min-w-0 items-center gap-4"
			aria-label="Ir a la página de inicio"
		>
			<div class="flex shrink-0 items-center">
				<img
					src={logoUrl}
					alt="GAD Provincial Santo Domingo de los Tsáchilas"
					class="h-12 w-auto object-contain sm:h-14"
				/>
			</div>

			<div
				class="hidden h-11 w-px shrink-0 bg-white/25 sm:block"
				aria-hidden="true"
			></div>

			<div class="hidden min-w-0 sm:block">
				<p
					class="text-xs font-semibold uppercase tracking-[0.18em] text-white/65"
				>
					GAD Provincial
				</p>

				<p
					class="truncate text-base font-bold leading-tight text-white lg:text-xl"
				>
					Sistema de Denuncias de Cunetas
				</p>
			</div>
		</a>

		<!-- Navegación de escritorio -->
		<nav
			class="hidden items-center gap-2 md:flex"
			aria-label="Navegación principal"
		>
			{
				navItems.map((item) => (
					<a
						href={item.href}
						aria-current={isActive(item.href) ? "page" : undefined}
						class:list={[
							"relative rounded-xl px-4 py-3 text-sm font-semibold transition duration-200",
							isActive(item.href)
								? "bg-white text-[#061B4E] shadow-md"
								: "text-white/85 hover:bg-white/10 hover:text-white",
						]}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<!-- Botón móvil -->
		<button
			id="menu-button"
			type="button"
			class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-white/20 text-white transition hover:bg-white/10 md:hidden"
			aria-label="Abrir menú de navegación"
			aria-controls="mobile-menu"
			aria-expanded="false"
		>
			<svg
				id="menu-open-icon"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="h-6 w-6"
				aria-hidden="true"
			>
				<line x1="4" y1="6" x2="20" y2="6"></line>
				<line x1="4" y1="12" x2="20" y2="12"></line>
				<line x1="4" y1="18" x2="20" y2="18"></line>
			</svg>

			<svg
				id="menu-close-icon"
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="hidden h-6 w-6"
				aria-hidden="true"
			>
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</div>

	<!-- Navegación móvil -->
	<nav
		id="mobile-menu"
		class="hidden border-t border-white/10 bg-[#061B4E] px-4 pb-5 pt-4 md:hidden"
		aria-label="Navegación móvil"
	>
		<div class="mx-auto flex max-w-7xl flex-col gap-2">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						aria-current={isActive(item.href) ? "page" : undefined}
						class:list={[
							"rounded-xl px-4 py-3 text-sm font-semibold transition",
							isActive(item.href)
								? "bg-white text-[#061B4E]"
								: "text-white/85 hover:bg-white/10 hover:text-white",
						]}
					>
						{item.label}
					</a>
				))
			}
		</div>
	</nav>
</header>

<script>
	const initializeNavbar = () => {
		const button =
			document.querySelector<HTMLButtonElement>("#menu-button");

		const menu =
			document.querySelector<HTMLElement>("#mobile-menu");

		const openIcon =
			document.querySelector<HTMLElement>("#menu-open-icon");

		const closeIcon =
			document.querySelector<HTMLElement>("#menu-close-icon");

		if (!button || !menu) return;

		const closeMenu = () => {
			menu.classList.add("hidden");
			openIcon?.classList.remove("hidden");
			closeIcon?.classList.add("hidden");

			button.setAttribute("aria-expanded", "false");
			button.setAttribute(
				"aria-label",
				"Abrir menú de navegación",
			);
		};

		const openMenu = () => {
			menu.classList.remove("hidden");
			openIcon?.classList.add("hidden");
			closeIcon?.classList.remove("hidden");

			button.setAttribute("aria-expanded", "true");
			button.setAttribute(
				"aria-label",
				"Cerrar menú de navegación",
			);
		};

		button.addEventListener("click", () => {
			const isOpen =
				button.getAttribute("aria-expanded") === "true";

			if (isOpen) {
				closeMenu();
				return;
			}

			openMenu();
		});

		menu.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", closeMenu);
		});

		window.addEventListener("resize", () => {
			if (window.innerWidth >= 768) {
				closeMenu();
			}
		});
	};

	initializeNavbar();

	document.addEventListener(
		"astro:page-load",
		initializeNavbar,
	);
</script>