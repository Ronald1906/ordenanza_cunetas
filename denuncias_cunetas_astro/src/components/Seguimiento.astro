---
let API_URL = (import.meta.env.PUBLIC_API_URL ?? "").trim();
while (API_URL.endsWith("/")) API_URL = API_URL.slice(0, -1);
const SEGUIMIENTO_DENUNCIA_URL = API_URL ? `${API_URL}/public/denuncias/seguimiento` : "";
const DISPONIBILIDAD_URL = API_URL ? `${API_URL}/public/denuncias/catalogos` : "";
---

<section data-seguimiento-contenedor data-disponibilidad-endpoint={DISPONIBILIDAD_URL} class="min-h-full bg-slate-100 px-4 py-10 sm:px-6 lg:px-8">
	<div class="mx-auto w-full max-w-5xl">
		<div
			class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-900/5"
		>

            <div id="estado-servicio-seguimiento" role="status" aria-live="polite" aria-atomic="true" class="px-6 py-14 text-center sm:px-10 sm:py-20">
                <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-blue-50 text-[#0A3D91]" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-8 w-8"><path d="M12 8v4l3 2" /><circle cx="12" cy="12" r="9" /></svg>
                </div>
                <h2 id="titulo-servicio-seguimiento" class="text-2xl font-extrabold text-[#061B4E] sm:text-3xl">Estamos preparando la consulta</h2>
                <p id="mensaje-servicio-seguimiento" class="mx-auto mt-4 max-w-xl text-sm leading-7 text-slate-600 sm:text-base">Por favor, espere un momento.</p>
                <button id="btn-reintentar-seguimiento" type="button" class="mt-7 hidden rounded-xl bg-[#061B4E] px-6 py-3 text-sm font-bold text-white transition hover:bg-[#0A3D91] focus:outline-none focus:ring-4 focus:ring-blue-200 disabled:cursor-not-allowed disabled:opacity-60">Volver a intentar</button>
                <noscript><p class="mx-auto mt-5 max-w-xl text-sm leading-6 text-slate-600">Para utilizar este servicio, active JavaScript en su navegador y vuelva a cargar la página.</p></noscript>
            </div>
            <div id="contenido-seguimiento" class="hidden">
			<!-- ===================================================== -->
			<!-- CABECERA -->
			<!-- ===================================================== -->

			<div
				class="border-b border-slate-200 px-5 pb-6 pt-7 sm:px-8 sm:pb-7 sm:pt-8"
			>
				<p
					class="text-xs font-bold uppercase tracking-[0.2em] text-[#0A3D91]"
				>
					Consulta ciudadana
				</p>

				<h1
					class="mt-2 text-3xl font-black leading-tight text-[#061B4E] sm:text-4xl"
				>
					Seguimiento de denuncia
				</h1>

				<p
					class="mt-3 max-w-3xl text-sm leading-6 text-slate-600 sm:text-base"
				>
					Ingrese el número asignado al momento de registrar su
					denuncia para consultar su estado actual y el historial de
					atención.
				</p>
			</div>

			<div class="p-5 sm:p-8">
				<!-- ================================================= -->
				<!-- FORMULARIO DE CONSULTA -->
				<!-- ================================================= -->

				<form
					id="form-seguimiento"
					data-endpoint={SEGUIMIENTO_DENUNCIA_URL}
					novalidate
				>
					<div
						class="rounded-2xl border border-slate-200 bg-slate-50 p-5 sm:p-6"
					>
						<div class="flex items-start gap-3">
							<span
								class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#EAF4FF] text-[#0A3D91]"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									class="h-5 w-5"
									aria-hidden="true"
								>
									<circle cx="11" cy="11" r="8"></circle>
									<path d="m21 21-4.35-4.35"></path>
								</svg>
							</span>

							<div>
								<h2 class="font-extrabold text-[#061B4E]">
									Consultar una denuncia
								</h2>

								<p
									class="mt-1 text-sm leading-6 text-slate-600"
								>
									El número tiene un formato similar a
									<span
										class="ml-1 inline-flex rounded-md bg-blue-50 px-2 py-0.5 font-bold tracking-wide text-[#0A3D91]"
									>
										DC-2026-000001
									</span>
								</p>
							</div>
						</div>

						<div class="mt-5 flex flex-col gap-3 sm:flex-row">
							<div class="flex-1">
								<label
									for="numero-denuncia"
									class="mb-2 block text-sm font-semibold text-slate-700"
								>
									Número de denuncia
									<span class="text-red-600">*</span>
								</label>

								<input
									id="numero-denuncia"
									name="numeroDenuncia"
									type="text"
									required
									maxlength="30"
									autocomplete="off"
									spellcheck="false"
									placeholder="Ejemplo: DC-2026-000001"
									class="h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm font-semibold uppercase tracking-wide text-slate-700 outline-none transition placeholder:font-normal placeholder:normal-case placeholder:tracking-normal placeholder:text-slate-400 focus:border-[#0A3D91] focus:ring-4 focus:ring-blue-100"
								/>
							</div>

							<div class="sm:flex sm:items-end">
								<button
									id="btn-consultar"
									type="submit"
									class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-[#061B4E] px-7 font-bold text-white shadow-lg shadow-blue-950/20 transition hover:bg-[#0A3D91] focus:outline-none focus:ring-4 focus:ring-blue-200 disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
								>
									<svg
										id="icono-consultar"
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										class="h-5 w-5"
										aria-hidden="true"
									>
										<circle cx="11" cy="11" r="8"></circle>
										<path d="m21 21-4.35-4.35"></path>
									</svg>

									<svg
										id="icono-cargando"
										class="hidden h-5 w-5 animate-spin"
										xmlns="http://www.w3.org/2000/svg"
										fill="none"
										viewBox="0 0 24 24"
										aria-hidden="true"
									>
										<circle
											class="opacity-25"
											cx="12"
											cy="12"
											r="10"
											stroke="currentColor"
											stroke-width="4"
										>
										</circle>

										<path
											class="opacity-75"
											fill="currentColor"
											d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4Z"
										>
										</path>
									</svg>

									<span id="texto-btn-consultar">
										Consultar
									</span>
								</button>
							</div>
						</div>
					</div>
				</form>

                <p id="mensaje-consulta-seguimiento" role="alert" class="mt-5 hidden rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900"></p>

				<!-- ===================================================== -->
				<!-- RESULTADO -->
				<!-- ===================================================== -->

				<div id="resultado-seguimiento" class="mt-8 hidden">
					<!-- ================================================= -->
					<!-- RESUMEN -->
					<!-- ================================================= -->

					<div
						class="overflow-hidden rounded-2xl border border-slate-200 bg-white"
					>
						<div
							class="border-b border-slate-200 bg-[#F8FAFC] px-5 py-5 sm:px-6"
						>
							<div
								class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
							>
								<div>
									<p
										class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500"
									>
										Número de denuncia
									</p>

									<p
										id="resultado-numero"
										class="mt-1 text-xl font-black tracking-wide text-[#061B4E] sm:text-2xl"
									>
										-
									</p>
								</div>

								<div class="sm:text-right">
									<p
										class="mb-2 text-xs font-bold uppercase tracking-[0.16em] text-slate-500"
									>
										Estado actual
									</p>

									<span
										id="resultado-estado"
										class="inline-flex items-center rounded-full border px-3 py-1.5 text-sm font-bold"
									>
										-
									</span>
								</div>
							</div>
						</div>

						<div class="grid gap-6 p-5 sm:grid-cols-2 sm:p-6">
							<div>
								<p
									class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500"
								>
									Fecha de registro
								</p>

								<p
									id="resultado-fecha"
									class="mt-2 font-bold text-slate-800"
								>
									-
								</p>
							</div>

							<div>
								<p
									class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500"
								>
									Estado
								</p>

								<p
									id="resultado-estado-nombre"
									class="mt-2 font-bold text-slate-800"
								>
									-
								</p>
							</div>

							<div class="sm:col-span-2">
								<p
									class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500"
								>
									Descripción registrada
								</p>

								<p
									id="resultado-descripcion"
									class="mt-2 whitespace-pre-line text-sm leading-7 text-slate-600"
								>
									-
								</p>
							</div>
						</div>
					</div>

					<!-- ================================================= -->
					<!-- HISTORIAL -->
					<!-- ================================================= -->

					<div
						class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 sm:p-6"
					>
						<div class="flex items-start gap-3">
							<span
								class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#EAF4FF] text-[#0A3D91]"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									class="h-5 w-5"
									aria-hidden="true"
								>
									<path d="M3 12a9 9 0 1 0 9-9"></path>
									<path d="M3 3v6h6"></path>
									<path d="M12 7v5l3 2"></path>
								</svg>
							</span>

							<div>
								<h2 class="font-extrabold text-[#061B4E]">
									Historial de seguimiento
								</h2>

								<p
									class="mt-1 text-sm leading-6 text-slate-600"
								>
									Consulte los cambios registrados durante la
									atención de la denuncia.
								</p>
							</div>
						</div>

						<div id="historial-seguimiento" class="mt-6"></div>

						<p
							id="sin-historial"
							class="mt-6 hidden rounded-xl border border-slate-200 bg-slate-50 px-4 py-4 text-sm text-slate-500"
						>
							No existen movimientos registrados para esta
							denuncia.
						</p>
					</div>

					<!-- ================================================= -->
					<!-- INFORMACIÓN -->
					<!-- ================================================= -->

					<div
						class="mt-6 rounded-2xl border border-blue-100 bg-[#F5FAFF] px-5 py-4"
					>
						<div class="flex items-start gap-3">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								class="mt-0.5 h-5 w-5 shrink-0 text-[#0A3D91]"
								aria-hidden="true"
							>
								<circle cx="12" cy="12" r="10"></circle>
								<path d="M12 16v-4"></path>
								<path d="M12 8h.01"></path>
							</svg>

							<p class="text-sm leading-6 text-slate-600">
								Conserve su número de denuncia. Podrá utilizarlo
								nuevamente para consultar futuras
								actualizaciones del trámite.
							</p>
						</div>
					</div>
				</div>
			</div>
            </div>
		</div>
	</div>
</section>

<script>
 type HistorialPublico = { estado: string; nombre: string; observacion: string | null; respuesta?: string | null; fecha: string };
 type SeguimientoResponse = { numero_denuncia: string; fecha_denuncia: string; estado: string; estado_nombre: string; descripcion: string; historial: HistorialPublico[] };
 const objeto = (value: unknown): value is Record<string, unknown> => typeof value === "object" && value !== null && !Array.isArray(value);
 const texto = (value: unknown): value is string => typeof value === "string";
 const opcional = (value: unknown) => value == null || texto(value);
 const patronNumero = /^DC-[0-9]{4}-[0-9]{6,}$/;
 const validarSeguimiento = (data: unknown): data is SeguimientoResponse => {
  if (!objeto(data) || !texto(data.numero_denuncia) || !patronNumero.test(data.numero_denuncia) || !texto(data.fecha_denuncia) || !texto(data.estado) || !texto(data.estado_nombre) || !texto(data.descripcion) || !Array.isArray(data.historial)) return false;
  return data.historial.every(item => objeto(item) && texto(item.estado) && texto(item.nombre) && texto(item.fecha) && opcional(item.observacion) && opcional(item.respuesta));
 };
 const clasesEstado: Record<string, string> = {
  REGISTRADA: "border-blue-200 bg-blue-50 text-blue-700",
  EN_REVISION: "border-amber-200 bg-amber-50 text-amber-700",
  EN_TRAMITE: "border-indigo-200 bg-indigo-50 text-indigo-700",
  ATENDIDA: "border-emerald-200 bg-emerald-50 text-emerald-700",
  CERRADA: "border-slate-300 bg-slate-100 text-slate-700",
  DESCARTADA: "border-red-200 bg-red-50 text-red-700",
 };
 function inicializarSeguimiento() {
  const raiz = document.querySelector<HTMLElement>("[data-seguimiento-contenedor]");
  if (!raiz || raiz.dataset.initialized === "true") return;
  const contenedor: HTMLElement = raiz;
  const campo = <T extends Element>(selector: string): T => {
   const elemento = contenedor.querySelector<T>(selector);
   if (!elemento) throw new Error(`Falta el elemento ${selector} del seguimiento.`);
   return elemento;
  };
  const formulario = campo<HTMLFormElement>("#form-seguimiento");
  const contenido = campo<HTMLElement>("#contenido-seguimiento");
  const estadoServicio = campo<HTMLElement>("#estado-servicio-seguimiento");
  const tituloServicio = campo<HTMLElement>("#titulo-servicio-seguimiento");
  const mensajeServicio = campo<HTMLElement>("#mensaje-servicio-seguimiento");
  const reintentar = campo<HTMLButtonElement>("#btn-reintentar-seguimiento");
  const mensajeConsulta = campo<HTMLElement>("#mensaje-consulta-seguimiento");
  const inputNumero = campo<HTMLInputElement>("#numero-denuncia");
  const botonConsultar = campo<HTMLButtonElement>("#btn-consultar");
  const textoBoton = campo<HTMLElement>("#texto-btn-consultar");
  const iconoConsultar = campo<SVGElement>("#icono-consultar");
  const iconoCargando = campo<SVGElement>("#icono-cargando");
  const resultado = campo<HTMLElement>("#resultado-seguimiento");
  const historialContenedor = campo<HTMLElement>("#historial-seguimiento");
  const sinHistorial = campo<HTMLElement>("#sin-historial");
  contenedor.dataset.initialized = "true";
  let consultando = false;
  let verificando = false;
  let disponible = false;
  let ultimoNumeroConsultado = "";
  const ocultarResultado = () => { resultado.classList.add("hidden"); historialContenedor.replaceChildren(); };
  const avisar = (mensaje: string) => { mensajeConsulta.textContent = mensaje; mensajeConsulta.classList.toggle("hidden", !mensaje); };
  const actualizarControles = () => {
   formulario.setAttribute("aria-busy", String(consultando));
   botonConsultar.disabled = inputNumero.disabled = consultando || !disponible;
   textoBoton.textContent = consultando ? "Consultando..." : "Consultar";
   iconoConsultar.classList.toggle("hidden", consultando);
   iconoCargando.classList.toggle("hidden", !consultando);
   reintentar.disabled = verificando || consultando;
  };
  const mantenimiento = () => {
   disponible = false;
   contenido.classList.add("hidden");
   ocultarResultado(); avisar("");
   estadoServicio.classList.remove("hidden");
   estadoServicio.setAttribute("role", "alert");
   estadoServicio.setAttribute("aria-busy", "false");
   tituloServicio.textContent = "Estamos en mantenimiento";
   mensajeServicio.textContent = "En este momento la consulta de denuncias no está disponible. Por favor, intente nuevamente más tarde. Gracias por su comprensión.";
   reintentar.classList.remove("hidden");
   actualizarControles();
  };
  const consultarJSON = async (url: string) => {
   const controller = new AbortController();
   const timeout = window.setTimeout(() => controller.abort(), 15000);
   try {
    const response = await fetch(url, { method: "GET", headers: { Accept: "application/json" }, cache: "no-store", signal: controller.signal });
    const data: unknown = await response.json().catch(() => null);
    return { response, data };
   } finally { window.clearTimeout(timeout); }
  };
  // Utiliza la ruta de catálogos ya existente para comprobar disponibilidad
  // sin consultar ni inventar un número de denuncia.
  const verificarDisponibilidad = async () => {
   if (verificando || consultando) return;
   verificando = true; disponible = false;
   contenido.classList.add("hidden"); ocultarResultado(); avisar("");
   estadoServicio.classList.remove("hidden"); estadoServicio.setAttribute("role", "status"); estadoServicio.setAttribute("aria-busy", "true");
   tituloServicio.textContent = "Estamos preparando la consulta";
   mensajeServicio.textContent = "Por favor, espere un momento.";
   reintentar.classList.add("hidden"); actualizarControles();
   try {
    const endpoint = contenedor.dataset.disponibilidadEndpoint;
    if (!endpoint || !formulario.dataset.endpoint) throw new Error("No están configurados los servicios del seguimiento.");
    const { response, data } = await consultarJSON(endpoint);
    if (!response.ok || !objeto(data) || !objeto(data.catalogos)) throw new Error(`No fue posible verificar el servicio. HTTP ${response.status}`);
    disponible = true; estadoServicio.classList.add("hidden"); contenido.classList.remove("hidden");
   } catch (error) {
    console.error("[SEGUIMIENTO] Verificación de disponibilidad:", error);
    mantenimiento();
   } finally {
    verificando = false; estadoServicio.setAttribute("aria-busy", "false"); actualizarControles();
   }
  };
  const formatearFecha = (value: string, hora = false): string => {
   // La fecha de denuncia es un DATE: conserva el día del registro.
   const fecha = new Date(hora ? value : `${value.slice(0, 10)}T12:00:00-05:00`);
   if (Number.isNaN(fecha.getTime())) return "Fecha no disponible";
   return new Intl.DateTimeFormat("es-EC", { timeZone: "America/Guayaquil", day: "2-digit", month: "long", year: "numeric", ...(hora ? { hour: "2-digit", minute: "2-digit" } as const : {}) }).format(fecha);
  };
  const crearHistorialItem = (item: HistorialPublico, ultimo: boolean) => {
   const fila = document.createElement("div"); fila.className = "relative flex gap-4";
   const indicador = document.createElement("div"); indicador.className = "relative flex w-8 shrink-0 justify-center";
   const punto = document.createElement("span"); punto.className = "relative z-10 mt-1 h-8 w-8 rounded-full border-4 border-white bg-[#0A3D91] shadow";
   indicador.append(punto);
   if (!ultimo) { const linea = document.createElement("span"); linea.className = "absolute left-1/2 top-8 h-[calc(100%-1rem)] w-px -translate-x-1/2 bg-slate-200"; indicador.append(linea); }
   const detalle = document.createElement("div"); detalle.className = ultimo ? "min-w-0 flex-1 pb-1" : "min-w-0 flex-1 pb-7";
   const cabecera = document.createElement("div"); cabecera.className = "flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between";
   const nombre = document.createElement("p"); nombre.className = "font-extrabold text-[#061B4E]"; nombre.textContent = item.nombre;
   const fecha = document.createElement("p"); fecha.className = "text-xs font-medium text-slate-500"; fecha.textContent = formatearFecha(item.fecha, true);
   cabecera.append(nombre, fecha); detalle.append(cabecera);
   if (item.respuesta?.trim()) {
    const respuesta = document.createElement("div"); respuesta.className = "mt-3 rounded-xl border border-blue-100 bg-blue-50 px-4 py-3";
    const titulo = document.createElement("p"); titulo.className = "mb-1 text-xs font-bold text-[#0A3D91]"; titulo.textContent = "Respuesta de la institución";
    const texto = document.createElement("p"); texto.className = "whitespace-pre-wrap break-words text-sm leading-6 text-slate-700"; texto.textContent = item.respuesta;
    respuesta.append(titulo, texto); detalle.append(respuesta);
   } else if (item.observacion?.trim()) {
    const observacion = document.createElement("p"); observacion.className = "mt-2 whitespace-pre-wrap break-words rounded-xl bg-slate-50 px-4 py-3 text-sm leading-6 text-slate-600"; observacion.textContent = item.observacion; detalle.append(observacion);
   }
   fila.append(indicador, detalle); return fila;
  };
  const mostrarResultado = (data: SeguimientoResponse) => {
   campo<HTMLElement>("#resultado-numero").textContent = data.numero_denuncia;
   campo<HTMLElement>("#resultado-fecha").textContent = formatearFecha(data.fecha_denuncia);
   campo<HTMLElement>("#resultado-estado-nombre").textContent = data.estado_nombre;
   campo<HTMLElement>("#resultado-descripcion").textContent = data.descripcion;
   const estado = campo<HTMLElement>("#resultado-estado");
   estado.className = `inline-flex items-center rounded-full border px-3 py-1.5 text-sm font-bold ${clasesEstado[data.estado] ?? "border-slate-200 bg-slate-50 text-slate-700"}`;
   estado.textContent = data.estado_nombre;
   historialContenedor.replaceChildren(); sinHistorial.classList.toggle("hidden", data.historial.length > 0);
   data.historial.forEach((item, index) => historialContenedor.append(crearHistorialItem(item, index === data.historial.length - 1)));
   resultado.classList.remove("hidden"); resultado.scrollIntoView({ behavior: "smooth", block: "start" });
  };
  inputNumero.addEventListener("input", () => { inputNumero.value = inputNumero.value.toUpperCase(); ocultarResultado(); avisar(""); });
  reintentar.addEventListener("click", () => void verificarDisponibilidad());
  formulario.addEventListener("submit", async event => {
   event.preventDefault();
   if (consultando || verificando || !disponible) return;
   inputNumero.value = inputNumero.value.trim().toUpperCase();
   if (!formulario.checkValidity()) { formulario.reportValidity(); return; }
   const numero = inputNumero.value;
   if (numero.length > 30 || !patronNumero.test(numero)) { ocultarResultado(); avisar("Verifique el número de denuncia e ingréselo nuevamente. Ejemplo: DC-2026-000001."); inputNumero.focus(); return; }
   const endpoint = formulario.dataset.endpoint;
   if (!endpoint) { mantenimiento(); return; }
   ultimoNumeroConsultado = numero;
   ocultarResultado(); avisar(""); consultando = true; actualizarControles();
   try {
    const { response, data } = await consultarJSON(`${endpoint}/${encodeURIComponent(numero)}`);
    // No encontrada o número inválido no implican mantenimiento del sistema.
    if (response.status === 404) { avisar("No encontramos una denuncia con ese número. Verifique que esté escrito correctamente e intente nuevamente."); return; }
    if (response.status === 400) { avisar("El número de denuncia no es válido. Revíselo e intente nuevamente."); return; }
    if (response.status === 429) { avisar("Ha realizado varias consultas seguidas. Espere un momento antes de volver a intentar."); return; }
    if (!response.ok || !validarSeguimiento(data) || data.numero_denuncia !== ultimoNumeroConsultado) throw new Error(`No fue posible obtener el seguimiento. HTTP ${response.status}`);
    mostrarResultado(data);
   } catch (error) {
    console.error("[SEGUIMIENTO] Error de consulta:", error);
    mantenimiento();
   } finally { consultando = false; actualizarControles(); }
  });
  void verificarDisponibilidad();
 }
 inicializarSeguimiento();
 document.addEventListener("astro:page-load", inicializarSeguimiento);
</script>
