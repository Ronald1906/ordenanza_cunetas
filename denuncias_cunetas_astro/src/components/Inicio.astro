---
---

<section class="min-h-full bg-slate-100">
	<!-- HERO -->
	<div
		class="relative overflow-hidden bg-linear-to-br from-[#061B4E] via-[#082A6B] to-[#0A3D91]"
	>
		<div
			class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-white/5"
			aria-hidden="true"
		></div>

		<div
			class="absolute -bottom-32 left-1/3 h-96 w-96 rounded-full bg-white/5"
			aria-hidden="true"
		></div>

		<div
			class="relative mx-auto grid w-full max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.2fr_0.8fr] lg:px-8 lg:py-24"
		>
			<div>
				<p
					class="mb-4 inline-flex rounded-full border border-white/20 bg-white/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-blue-100"
				>
					Servicio ciudadano
				</p>

				<h1
					class="max-w-4xl text-4xl font-black leading-tight text-white sm:text-5xl lg:text-6xl"
				>
					Denuncie problemas relacionados con la limpieza de cunetas
				</h1>

				<p
					class="mt-6 max-w-3xl text-base leading-8 text-blue-100 sm:text-lg text-justify"
				>
					Este sistema permite informar a la institución sobre cunetas
					obstruidas, acumulación de residuos, agua estancada y otras
					condiciones que puedan afectar el drenaje y la seguridad del
					sector.
				</p>

				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a
						href="/formulario"
						class="inline-flex h-13 items-center justify-center gap-2 rounded-xl bg-white px-7 font-bold text-[#061B4E] shadow-xl transition hover:-translate-y-0.5 hover:bg-blue-50"
					>
						Registrar una denuncia

						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							class="h-5 w-5"
							aria-hidden="true"
						>
							<path d="M5 12h14"></path>
							<path d="m13 6 6 6-6 6"></path>
						</svg>
					</a>

					<a
						href="/seguimiento"
						class="inline-flex h-13 items-center justify-center rounded-xl border border-white/30 bg-white/10 px-7 font-bold text-white transition hover:bg-white/20"
					>
						Consultar seguimiento
					</a>
				</div>
			</div>

			<!-- Resumen -->
			<div
				class="rounded-3xl border border-white/15 bg-white/10 p-6 shadow-2xl backdrop-blur-sm"
			>
				<p
					class="text-xs font-bold uppercase tracking-[0.18em] text-blue-100"
				>
					Antes de denunciar
				</p>

				<h2 class="mt-3 text-2xl font-black text-white text-justify">
					Prepare la información del problema
				</h2>

				<div class="mt-6 space-y-4">
					<div class="flex items-start gap-4 rounded-2xl bg-white p-4">
						<span
							class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#EAF4FF] text-[#0A3D91]"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								class="h-5 w-5"
								aria-hidden="true"
							>
								<path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
								<circle cx="12" cy="10" r="3"></circle>
							</svg>
						</span>

						<div>
							<p class="font-extrabold text-[#061B4E]">
								Ubicación clara
							</p>

							<p class="mt-1 text-sm leading-6 text-slate-600 text-justify">
								Indique el cantón, parroquia, sector y,
								de ser posible, las coordenadas.
							</p>
						</div>
					</div>

					<div class="flex items-start gap-4 rounded-2xl bg-white p-4">
						<span
							class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#EAF4FF] text-[#0A3D91]"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								class="h-5 w-5"
								aria-hidden="true"
							>
								<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
								<polyline points="17 8 12 3 7 8"></polyline>
								<line x1="12" y1="3" x2="12" y2="15"></line>
							</svg>
						</span>

						<div>
							<p class="font-extrabold text-[#061B4E]">
								Evidencias
							</p>

							<p class="mt-1 text-sm leading-6 text-slate-600 text-justify">
								Adjunte fotografías o videos que permitan
								identificar las condiciones de la cuneta.
							</p>
						</div>
					</div>

					<div class="flex items-start gap-4 rounded-2xl bg-white p-4">
						<span
							class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#EAF4FF] text-[#0A3D91]"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								class="h-5 w-5"
								aria-hidden="true"
							>
								<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
								<path d="M14 2v6h6"></path>
								<path d="M8 13h8"></path>
								<path d="M8 17h5"></path>
							</svg>
						</span>

						<div>
							<p class="font-extrabold text-[#061B4E]">
								Descripción suficiente
							</p>

							<p class="mt-1 text-sm leading-6 text-slate-600 text-justify">
								Explique qué sucede, desde cuándo y qué
								riesgos o afectaciones se observan.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- CONTENIDO GENERAL -->
	<div
		class="mx-auto w-full max-w-7xl space-y-16 px-4 py-12 sm:px-6 lg:px-8 lg:py-16"
	>
		<!-- CÓMO DENUNCIAR -->
		<section>
			<div class="mb-9 max-w-3xl">
				<p
					class="text-xs font-bold uppercase tracking-[0.2em] text-[#0A3D91]"
				>
					Información general
				</p>

				<h2
					class="mt-3 text-3xl font-black text-[#061B4E] sm:text-4xl"
				>
					¿Cómo denunciar?
				</h2>

				<p class="mt-4 text-base leading-7 text-slate-600 text-justify">
					Cualquier ciudadano puede presentar una denuncia cuando
					identifique problemas relacionados con la limpieza,
					obstrucción o mantenimiento de cunetas en sectores urbanos
					o rurales.
				</p>
			</div>

			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				<article
					class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-900/5"
				>
					<div
						class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-[#EAF4FF] text-[#0A3D91]"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							class="h-6 w-6"
							aria-hidden="true"
						>
							<path d="M3 6h18"></path>
							<path d="M5 6l1 14h12l1-14"></path>
							<path d="M9 10v6"></path>
							<path d="M15 10v6"></path>
							<path d="M8 6l1-3h6l1 3"></path>
						</svg>
					</div>

					<h3 class="text-lg font-extrabold text-[#061B4E]">
						Cunetas obstruidas
					</h3>

					<p class="mt-3 text-sm leading-6 text-slate-600 text-justify">
						Acumulación de basura, tierra, maleza, sedimentos u
						otros materiales que impidan el paso del agua.
					</p>
				</article>

				<article
					class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-900/5"
				>
					<div
						class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-[#EAF4FF] text-[#0A3D91]"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							class="h-6 w-6"
							aria-hidden="true"
						>
							<path d="M12 2.7 5.6 9.3a9 9 0 1 0 12.8 0Z"></path>
						</svg>
					</div>

					<h3 class="text-lg font-extrabold text-[#061B4E]">
						Agua estancada
					</h3>

					<p class="mt-3 text-sm leading-6 text-slate-600 text-justify">
						Presencia de agua acumulada por falta de limpieza,
						drenaje insuficiente o bloqueo del cauce.
					</p>
				</article>

				<article
					class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-900/5"
				>
					<div
						class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-[#EAF4FF] text-[#0A3D91]"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							class="h-6 w-6"
							aria-hidden="true"
						>
							<path d="M12 9v4"></path>
							<path d="M12 17h.01"></path>
							<path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z"></path>
						</svg>
					</div>

					<h3 class="text-lg font-extrabold text-[#061B4E]">
						Riesgo de inundación
					</h3>

					<p class="mt-3 text-sm leading-6 text-slate-600 text-justify">
						Condiciones que puedan provocar desbordamientos,
						afectaciones a viviendas, vías o espacios públicos.
					</p>
				</article>
			</div>
		</section>

		<!-- PROCESO -->
		<section
			class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-900/5 sm:p-8 lg:p-10"
		>
			<div class="mb-9 text-center">
				<p
					class="text-xs font-bold uppercase tracking-[0.2em] text-[#0A3D91]"
				>
					Proceso de registro
				</p>

				<h2
					class="mt-3 text-3xl font-black text-[#061B4E] sm:text-4xl"
				>
					Presente su denuncia en tres pasos
				</h2>

				<p
					class="mx-auto mt-4 max-w-3xl text-base leading-7 text-slate-600"
				>
					El formulario está diseñado para registrar la información
					necesaria de manera sencilla y permitir que el área
					responsable pueda revisar el caso.
				</p>
			</div>

			<div class="grid gap-6 md:grid-cols-3">
				<article class="relative rounded-2xl bg-slate-50 p-6">
					<span
						class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-[#061B4E] text-lg font-black text-white"
					>
						1
					</span>

					<h3 class="text-lg font-extrabold text-[#061B4E]">
						Seleccione el tipo de denuncia
					</h3>

					<p class="mt-3 text-sm leading-6 text-slate-600 text-justify">
						Indique si desea registrar una denuncia identificada
						o una denuncia anónima.
					</p>
				</article>

				<article class="relative rounded-2xl bg-slate-50 p-6">
					<span
						class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-[#061B4E] text-lg font-black text-white"
					>
						2
					</span>

					<h3 class="text-lg font-extrabold text-[#061B4E]">
						Registre la ubicación
					</h3>

					<p class="mt-3 text-sm leading-6 text-slate-600 text-justify">
						Ingrese los datos del sector, la ubicación del
						problema y una descripción clara de lo ocurrido.
					</p>
				</article>

				<article class="relative rounded-2xl bg-slate-50 p-6">
					<span
						class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-[#061B4E] text-lg font-black text-white"
					>
						3
					</span>

					<h3 class="text-lg font-extrabold text-[#061B4E]">
						Adjunte y envíe
					</h3>

					<p class="mt-3 text-sm leading-6 text-slate-600 text-justify">
						Agregue fotografías o videos y envíe el formulario
						para completar el registro.
					</p>
				</article>
			</div>
		</section>

		<!-- TIPOS DE DENUNCIA -->
		<section>
			<div class="mb-9 max-w-3xl">
				<p
					class="text-xs font-bold uppercase tracking-[0.2em] text-[#0A3D91]"
				>
					Modalidades disponibles
				</p>

				<h2
					class="mt-3 text-3xl font-black text-[#061B4E] sm:text-4xl"
				>
					Tipos de denuncia
				</h2>

				<p class="mt-4 text-base leading-7 text-slate-600 text-justify">
					El ciudadano puede decidir si desea proporcionar sus datos
					personales o registrar la denuncia sin identificarse.
				</p>
			</div>

			<div class="grid gap-6 lg:grid-cols-2">
				<article
					class="overflow-hidden rounded-3xl border border-blue-100 bg-white shadow-lg shadow-slate-900/5"
				>
					<div class="bg-[#061B4E] px-6 py-5">
						<div class="flex items-center gap-4">
							<span
								class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-white"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									class="h-6 w-6"
									aria-hidden="true"
								>
									<path d="M20 21a8 8 0 0 0-16 0"></path>
									<circle cx="12" cy="7" r="4"></circle>
								</svg>
							</span>

							<div>
								<p
									class="text-xs font-bold uppercase tracking-[0.16em] text-blue-200"
								>
									Modalidad 1
								</p>

								<h3 class="text-xl font-black text-white">
									Denuncia identificada
								</h3>
							</div>
						</div>
					</div>

					<div class="p-6">
						<p class="leading-7 text-slate-600 text-justify">
							El denunciante proporciona sus datos personales y
							de contacto. Esto permite que la institución pueda
							comunicarse en caso de requerir aclaraciones o
							información adicional.
						</p>

						<ul class="mt-5 space-y-3 text-sm text-slate-700">
							<li class="flex items-start gap-3">
								<span class="mt-1 text-green-600">✓</span>
								<span>Cédula o RUC.</span>
							</li>

							<li class="flex items-start gap-3">
								<span class="mt-1 text-green-600">✓</span>
								<span>Correo electrónico y teléfono.</span>
							</li>

							<li class="flex items-start gap-3">
								<span class="mt-1 text-green-600">✓</span>
								<span>
									Posibilidad de contacto para aclarar la
									información.
								</span>
							</li>
						</ul>
					</div>
				</article>

				<article
					class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-lg shadow-slate-900/5"
				>
					<div class="bg-slate-800 px-6 py-5">
						<div class="flex items-center gap-4">
							<span
								class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-white"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									class="h-6 w-6"
									aria-hidden="true"
								>
									<path d="M17.5 19H9a7 7 0 1 1 6.7-9"></path>
									<path d="M12 12v.01"></path>
									<path d="m18 8 4 4"></path>
									<path d="m22 8-4 4"></path>
								</svg>
							</span>

							<div>
								<p
									class="text-xs font-bold uppercase tracking-[0.16em] text-slate-300"
								>
									Modalidad 2
								</p>

								<h3 class="text-xl font-black text-white">
									Denuncia anónima
								</h3>
							</div>
						</div>
					</div>

					<div class="p-6">
						<p class="leading-7 text-slate-600 text-justify">
							El ciudadano puede registrar una denuncia sin
							proporcionar sus datos personales. En este caso,
							la información del problema debe ser suficientemente
							clara para permitir su revisión.
						</p>

						<ul class="mt-5 space-y-3 text-sm text-slate-700">
							<li class="flex items-start gap-3">
								<span class="mt-1 text-green-600">✓</span>
								<span>No requiere datos personales.</span>
							</li>

							<li class="flex items-start gap-3">
								<span class="mt-1 text-green-600">✓</span>
								<span>Debe incluir una ubicación precisa.</span>
							</li>

							<li class="flex items-start gap-3">
								<span class="mt-1 text-green-600">✓</span>
								<span>
									Debe contener descripción y evidencias
									suficientes.
								</span>
							</li>
						</ul>
					</div>
				</article>
			</div>
		</section>

		<!-- CONDICIONES -->
		<section class="grid gap-6 lg:grid-cols-2">
			<article
				class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8"
			>
				<div class="flex items-start gap-4">
					<span
						class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-700"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							class="h-6 w-6"
							aria-hidden="true"
						>
							<path d="M12 9v4"></path>
							<path d="M12 17h.01"></path>
							<path d="M10.3 2.9 1.8 17a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 2.9a2 2 0 0 0-3.4 0Z"></path>
						</svg>
					</span>

					<div>
						<h2 class="text-2xl font-black text-amber-900">
							¿Cuándo podría no ser atendida?
						</h2>

						<p class="mt-3 leading-7 text-amber-900/80 text-justify">
							Una denuncia podría no continuar con el proceso
							cuando no exista información suficiente para
							localizar o verificar el problema.
						</p>
					</div>
				</div>

				<ul class="mt-6 space-y-3 text-sm leading-6 text-amber-950">
					<li class="flex items-start gap-3">
						<span class="mt-1 font-black">•</span>
						<span>
							No se proporciona una ubicación clara o verificable.
						</span>
					</li>

					<li class="flex items-start gap-3">
						<span class="mt-1 font-black">•</span>
						<span>
							La descripción no permite comprender el problema.
						</span>
					</li>

					<li class="flex items-start gap-3">
						<span class="mt-1 font-black">•</span>
						<span>
							El asunto reportado no corresponde a la competencia
							institucional.
						</span>
					</li>

					<li class="flex items-start gap-3">
						<span class="mt-1 font-black">•</span>
						<span>
							La información o las evidencias proporcionadas son
							falsas o manipuladas.
						</span>
					</li>
				</ul>
			</article>

			<article
				class="rounded-3xl border border-blue-100 bg-[#F5FAFF] p-6 sm:p-8"
			>
				<div class="flex items-start gap-4">
					<span
						class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#EAF4FF] text-[#0A3D91]"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							class="h-6 w-6"
							aria-hidden="true"
						>
							<circle cx="12" cy="12" r="10"></circle>
							<polyline points="12 6 12 12 16 14"></polyline>
						</svg>
					</span>

					<div>
						<h2 class="text-2xl font-black text-[#061B4E]">
							Plazo y proceso de atención
						</h2>

						<p class="mt-3 leading-7 text-slate-600 text-justify">
							La denuncia será revisada por el área técnica
							correspondiente. El tiempo de atención dependerá de
							la prioridad, la inspección requerida, la ubicación
							y la disponibilidad operativa.
						</p>
					</div>
				</div>

				<div class="mt-6 rounded-2xl border border-blue-100 bg-white p-5">
					<p class="text-sm font-bold text-[#061B4E]">
						Tenga presente
					</p>

					<p class="mt-2 text-sm leading-6 text-slate-600">
						El registro de una denuncia no implica una atención
						inmediata ni una fecha automática de ejecución. Cada
						caso debe ser revisado y priorizado técnicamente.
